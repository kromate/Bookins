    "workflows": [
      {
        "id": "owner-daily-agenda",
        "name": "Bookins - daily agenda email",
        "description": "Every morning, reads Bookings and emails the account owner today's appointments, today's time off, and bookings received in the last 24 hours. Guests are not emailed.",
        "enabledOnInstall": false,
        "trigger": {
          "id": "agenda-schedule",
          "nodeId": "SCHEDULE_INTERVAL",
          "name": "Daily agenda schedule",
          "props": {
            "PlainText": "Every day at 7:00 AM",
            "cron": "0 7 * * *",
            "timezone": "Africa/Lagos"
          }
        },
        "steps": [
          {
            "id": "read-bookings",
            "nodeId": "TABLE_READ",
            "name": "Read recent bookings",
            "props": {
              "tableId": {
                "$appResource": {
                  "kind": "table",
                  "logicalResourceId": "bookings"
                }
              },
              "sortField": "created_at",
              "sortOrder": "desc",
              "limit": 200
            }
          },
          {
            "id": "build-agenda",
            "nodeId": "TRANSFORM_DATA",
            "name": "Format daily agenda",
            "props": {
              "transformFunction": "(data) => { const records = data && data.payload && Array.isArray(data.payload.records) ? data.payload.records : []; const now = Date.now(); const clean = (v) => String(v === null || v === undefined ? '' : v).replace(/[\\r\\n]+/g, ' ').trim(); const dayIn = (ms, tz) => { try { return new Intl.DateTimeFormat('en-CA', { timeZone: tz, year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date(ms)); } catch (e) { return new Date(ms).toISOString().slice(0, 10); } }; const timeIn = (ms, tz) => { try { return new Intl.DateTimeFormat('en-GB', { timeZone: tz, hour: '2-digit', minute: '2-digit' }).format(new Date(ms)); } catch (e) { return new Date(ms).toISOString().slice(11, 16) + ' UTC'; } }; const isOff = (r) => clean(r.status) === 'blocked' || clean(r.service_id) === 'time-off'; const email = (r) => /@bookins\\.invalid$/i.test(clean(r.guest_email)) ? '' : clean(r.guest_email); const today = []; const timeOff = []; const fresh = []; records.forEach((r) => { if (!r) return; const tz = clean(r.timezone) || 'UTC'; const start = Date.parse(r.starts_at); const end = Date.parse(r.ends_at); if (isNaN(start)) return; const status = clean(r.status); if (isOff(r)) { if (status === 'blocked' && !isNaN(end) && end > now && dayIn(start, tz) <= dayIn(now, tz) && dayIn(end, tz) >= dayIn(now, tz)) timeOff.push(timeIn(start, tz) + '-' + timeIn(end, tz) + ' ' + (clean(r.notes) || 'Time off') + ' (' + tz + ')'); return; } if (status !== 'cancelled' && dayIn(start, tz) === dayIn(now, tz)) today.push({ start, line: timeIn(start, tz) + ' ' + clean(r.service_name) + ' - ' + (clean(r.guest_name) || 'Guest') + (clean(r.guest_phone) ? ', ' + clean(r.guest_phone) : '') + (email(r) ? ', ' + email(r) : '') + ' (' + tz + ', ' + clean(r.reference) + ')' }); const created = Date.parse(r.created_at); if (!isNaN(created) && now - created <= 86400000 && status !== 'cancelled' && start > now) fresh.push({ start, line: dayIn(start, tz) + ' ' + timeIn(start, tz) + ' ' + clean(r.service_name) + ' - ' + (clean(r.guest_name) || 'Guest') + (clean(r.source) === 'owner' ? ' (added by you)' : '') + ' (' + tz + ')' }); }); today.sort((a, b) => a.start - b.start); fresh.sort((a, b) => a.start - b.start); const lines = ['Good morning. Here is your Bookins agenda.', '', 'TODAY (' + today.length + ')']; if (today.length) today.forEach((i) => lines.push('- ' + i.line)); else lines.push('- No appointments today.'); if (timeOff.length) { lines.push('', 'TIME OFF TODAY'); timeOff.forEach((l) => lines.push('- ' + l)); } lines.push('', 'NEW IN THE LAST 24 HOURS (' + fresh.length + ')'); if (fresh.length) fresh.forEach((i) => lines.push('- ' + i.line)); else lines.push('- No new bookings.'); lines.push('', 'Open Bookins to message clients, reschedule, or mark appointments completed.', 'Sent from noreply@goalmatic.io to the account owner only. Guests are not emailed. Based on your most recently created 200 bookings.'); const subject = 'Bookins: ' + (today.length ? today.length + ' appointment' + (today.length === 1 ? '' : 's') + ' today' : 'no appointments today') + (fresh.length ? ', ' + fresh.length + ' new' : ''); return { subject, body: lines.join('\\n') }; }"
