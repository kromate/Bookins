{
  "name": "@goalmatic/bookings",
  "private": true,
  "version": "0.9.0",
  "description": "Configure services and availability, share a secure booking page, and manage appointments through Goalmatic.",
  "packageManager": "yarn@1.22.22",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "yarn typecheck && vite build",
    "check:source": "node --import tsx scripts/check.mjs",
    "preview": "vite preview",
    "export:source": "node --import tsx scripts/export-source.mjs",
    "sync:agenda": "node --import tsx scripts/sync-agenda-workflow.mjs",
    "test": "node --import tsx --test tests/*.test.js",
    "typecheck": "vue-tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "qrcode": "1.5.4",
    "radix-vue": "1.9.17",
    "vue": "3.5.41",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/qrcode": "1.5.6",
    "@types/web-bluetooth": "0.0.22",
    "@vitejs/plugin-vue": "6.0.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vue-component-type-helpers": "3.3.12",
    "vue-tsc": "3.3.7"
  },
  "resolutions": {
    "@tanstack/virtual-core": "3.10.1",
    "@tanstack/vue-virtual": "3.10.1"
  }
}
